{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiathumanscale.com/schemas/applicability-rule.schema.json",
  "title": "Applicability Screening Rule",
  "type": "object",
  "required": ["record_type", "id", "obligation_id", "rationale", "review_status"],
  "properties": {
    "record_type": {"const": "applicability_rule"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "obligation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/criterion"},
      "description": "Legacy v1 all-conditions form."
    },
    "expression": {
      "$ref": "#/$defs/expression",
      "description": "Rule v2 declarative Boolean expression."
    },
    "rationale": {"type": "string", "minLength": 20},
    "review_status": {"enum": ["draft", "analyst_reviewed", "legal_reviewed", "approved", "rejected"]},
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "oneOf": [
        {"required": ["criteria"]},
        {"required": ["expression"]}
      ]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["fact", "operator"],
      "properties": {
        "fact": {"type": "string", "minLength": 1},
        "operator": {
          "enum": [
            "equals", "not_equals", "contains", "exists",
            "greater_than", "greater_than_or_equal",
            "less_than", "less_than_or_equal", "in", "not_in"
          ]
        },
        "value": {"type": ["string", "number", "boolean", "array", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"operator": {"const": "exists"}}},
          "then": {"not": {"required": ["value"]}},
          "else": {"required": ["value"]}
        }
      ],
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {"$ref": "#/$defs/criterion"},
        {
          "type": "object",
          "required": ["all"],
          "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": {"not": {"$ref": "#/$defs/expression"}},
          "additionalProperties": false
        }
      ]
    }
  }
}
