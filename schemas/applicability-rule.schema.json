{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiathumanscale.com/schemas/applicability-rule.schema.json",
  "title": "Applicability Screening Rule",
  "type": "object",
  "required": ["record_type", "id", "obligation_id", "criteria", "rationale", "review_status"],
  "properties": {
    "record_type": {"const": "applicability_rule"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "obligation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact", "operator"],
        "properties": {
          "fact": {"type": "string", "minLength": 1},
          "operator": {"enum": ["equals", "contains", "exists"]},
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "rationale": {"type": "string", "minLength": 20},
    "review_status": {"enum": ["draft", "analyst_reviewed", "legal_reviewed", "approved", "rejected"]},
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
