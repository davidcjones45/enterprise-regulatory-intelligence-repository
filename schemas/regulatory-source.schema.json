{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiathumanscale.com/schemas/regulatory-source.schema.json",
  "title": "Regulatory Source",
  "type": "object",
  "required": [
    "record_type", "id", "title", "source_type", "authority",
    "instrument_identifier", "jurisdictions", "official_url", "publication_date",
    "legal_status", "binding_effect", "review_status", "retrieved_at",
    "last_verified_at", "topics", "status_history"
  ],
  "properties": {
    "record_type": {"const": "regulatory_source"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "title": {"type": "string", "minLength": 3},
    "source_type": {
      "enum": [
        "bill", "statute", "regulation", "proposed_rule", "guidance", "policy",
        "enforcement_action", "executive_order", "court_decision",
        "voluntary_standard", "framework", "other"
      ]
    },
    "authority": {"type": "string", "minLength": 2},
    "instrument_identifier": {"type": "string", "minLength": 2},
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/jurisdiction"}
    },
    "official_url": {"$ref": "common.schema.json#/$defs/uri"},
    "navigation_url": {"type": ["string", "null"], "format": "uri"},
    "publication_date": {"$ref": "common.schema.json#/$defs/iso_date"},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "compliance_date": {"type": ["string", "null"], "format": "date"},
    "comment_deadline": {"type": ["string", "null"], "format": "date"},
    "legal_status": {
      "enum": [
        "introduced", "proposed", "enacted", "final_not_effective", "effective",
        "superseded", "repealed", "withdrawn", "nonbinding"
      ]
    },
    "binding_effect": {"enum": ["binding", "nonbinding", "mixed", "unknown"]},
    "review_status": {"enum": ["unreviewed", "source_verified", "substantive_reviewed"]},
    "version": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "last_verified_at": {"type": "string", "format": "date-time"},
    "content_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "covered_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["status", "date"],
        "properties": {
          "status": {
            "enum": [
              "introduced", "proposed", "passed", "enacted", "final_not_effective",
              "effective", "amended", "superseded", "repealed", "withdrawn", "nonbinding"
            ]
          },
          "date": {"$ref": "common.schema.json#/$defs/iso_date"},
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "related_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship", "instrument_identifier", "url"],
        "properties": {
          "relationship": {
            "enum": [
              "amends", "amended_by", "supersedes", "superseded_by",
              "implements", "implemented_by", "related_to"
            ]
          },
          "instrument_identifier": {"type": "string", "minLength": 2},
          "url": {"$ref": "common.schema.json#/$defs/uri"},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
