{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiathumanscale.com/schemas/obligation.schema.json",
  "title": "Normalized Obligation",
  "type": "object",
  "required": [
    "record_type", "id", "source_id", "title", "normalized_text",
    "obligation_type", "binding_status", "citations", "subjects",
    "actions", "review_status"
  ],
  "properties": {
    "record_type": {"const": "obligation"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "title": {"type": "string", "minLength": 3},
    "normalized_text": {"type": "string", "minLength": 10},
    "obligation_type": {
      "enum": [
        "prohibition", "mandatory_action", "documentation",
        "disclosure", "record_retention", "risk_assessment",
        "human_oversight", "third_party_assurance",
        "serious_incident_notification", "imminent_harm_escalation",
        "developer_size_threshold", "compute_threshold",
        "effective_date_staging", "regulator_authority",
        "enforcement_authority", "civil_penalty_exposure",
        "recommended_practice", "other"
      ]
    },
    "binding_status": {
      "enum": ["binding", "proposed", "advisory", "voluntary", "interpretive", "unknown"]
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/citation"}
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "objects": {
      "type": "array",
      "items": {"type": "string"}
    },
    "conditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "exceptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "deadline_expression": {"type": ["string", "null"]},
    "review_status": {
      "enum": ["machine_extracted", "analyst_reviewed", "legal_reviewed", "approved", "rejected"]
    },
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
